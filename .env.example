# DevOps Troubleshooting Chatbot - Environment Variables
# ======================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ===================
# OpenAI Configuration
# ===================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Model to use (default: gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview
OPENAI_MODEL=gpt-3.5-turbo

# ===================
# Ollama Configuration (Alternative - Free, Local)
# ===================
# Set to true to use Ollama instead of OpenAI
USE_OLLAMA=false

# Ollama model to use
# Run 'ollama list' to see available models
OLLAMA_MODEL=llama2

# Ollama server URL (default: localhost)
OLLAMA_BASE_URL=http://localhost:11434

# ===================
# Embedding Configuration
# ===================
# Options: openai, local
# 'local' uses sentence-transformers (free, runs on your machine)
# 'openai' uses OpenAI's embedding API (costs money, but better quality)
EMBEDDING_PROVIDER=local

# Local embedding model (if EMBEDDING_PROVIDER=local)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===================
# Vector Database
# ===================
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Collection name for DevOps knowledge
CHROMA_COLLECTION=devops_knowledge

# ===================
# Application Settings
# ===================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Number of relevant documents to retrieve
TOP_K_RESULTS=5

# Maximum tokens for context
MAX_CONTEXT_TOKENS=3000
